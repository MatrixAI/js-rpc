{
  "name": "@matrixai/rpc",
  "version": "1.0.1",
  "author": "Matrix AI",
  "contributors": [
    {
      "name": "Aditya V"
    },
    {
      "name": "Roger Qiu"
    },
    {
      "name": "Amy Yan"
    },
    {
      "name": "Brian Botha"
    }
  ],
  "description": "RPC for TypeScript/JavaScript Applications",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-rpc.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "lint": "matrixai-lint",
    "lintfix": "matrixai-lint --fix",
    "bench": "tsc -p ./tsconfig.build.json && shx rm -rf ./benches/results && tsx ./benches/index.ts",
    "typecheck": "tsc -p ./tsconfig.json",
    "check:package": "npm run build && node ./scripts/check-package.mjs",
    "check:portable": "node ./scripts/check-portable.mjs",
    "check:conformance": "npm run typecheck && npm test -- --runInBand && npm run check:package && npm run check:portable",
    "check": "npm run check:conformance && npm run lint"
  },
  "dependencies": {
    "@matrixai/async-init": "^2.1.2",
    "@matrixai/contexts": "^2.0.2",
    "@matrixai/errors": "^2.1.3",
    "@matrixai/events": "^4.0.1",
    "@matrixai/logger": "^4.0.3",
    "@streamparser/json": "^0.0.17"
  },
  "devDependencies": {
    "@fast-check/jest": "^2.1.0",
    "@swc/core": "1.3.82",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.2",
    "@types/node": "^24.0.0",
    "benny": "^3.7.1",
    "common-tags": "^1.8.2",
    "fast-check": "^4.0.0",
    "jest": "^29.6.2",
    "jest-extended": "^4.0.0",
    "jest-junit": "^16.0.0",
    "shx": "^0.3.4",
    "systeminformation": "^5.18.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/tsbuildinfo"
  ]
}
